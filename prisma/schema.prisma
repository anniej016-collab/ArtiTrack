// Prisma schema for ArtiTrack

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FollowStatus {
  ACTIVE
  PAUSED
}

enum ReleaseType {
  ALBUM
  EP
  SINGLE
  OTHER
}

model Artist {
  id       String       @id @default(cuid())
  name     String
  imageUrl String?
  notes    String?
  status   FollowStatus @default(ACTIVE)
  pausedAt DateTime?

  // Where this artist came from: "manual", or a provider key such as "deezer".
  source       String    @default("manual")
  externalId   String?
  lastSyncedAt DateTime?

  createdAt DateTime  @default(now())
  releases  Release[]

  // Stops the same provider artist being imported twice. Manually added artists
  // have a null externalId, and Postgres treats nulls as distinct, so any number
  // of them can coexist.
  @@unique([source, externalId])
  @@index([status])
}

model Release {
  id          String      @id @default(cuid())
  artistId    String
  artist      Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title       String
  type        ReleaseType @default(OTHER)
  releaseDate DateTime
  notes       String?
  coverUrl    String?
  createdAt   DateTime    @default(now())

  // Null means you haven't listened to this yet.
  listenedAt DateTime?

  // Provider id, so re-syncing updates a release instead of duplicating it.
  // Null for releases entered by hand.
  externalId String?

  @@unique([artistId, externalId])
  @@index([artistId])
  @@index([releaseDate])
  @@index([listenedAt])
}

// Prisma schema for ArtiTrack

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FollowStatus {
  ACTIVE
  PAUSED
}

enum ReleaseType {
  ALBUM
  EP
  SINGLE
  OTHER
}

model Artist {
  id             String       @id @default(cuid())
  name           String
  imageUrl       String?
  /// Set when the picture was typed in rather than taken from a service, so
  /// re-checking an artist never overwrites one chosen by hand.
  imageUrlByHand Boolean      @default(false)
  notes          String?
  status         FollowStatus @default(ACTIVE)
  pausedAt       DateTime?

  // Where this artist came from: "manual", "import", or a provider key such as
  // as "deezer". This is their origin, and is not what decides syncing.
  source     String  @default("manual")
  externalId String?

  // Where new releases are fetched from, which is a separate question. An
  // artist imported from a file has an origin but nothing to sync from until
  // one is chosen, and choosing one must not make them a second artist.
  syncSource     String?
  syncExternalId String?
  lastSyncedAt   DateTime?

  /// A fuller discography kept elsewhere, for catalogues no service covers well.
  discographyUrl String?

  createdAt DateTime  @default(now())
  releases  Release[]
  songs     Song[]

  // Stops the same provider artist being imported twice. Manually added artists
  // have a null externalId, and Postgres treats nulls as distinct, so any number
  // of them can coexist.
  @@unique([source, externalId])
  @@index([status])
}

model Release {
  id          String      @id @default(cuid())
  artistId    String
  artist      Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title       String
  type        ReleaseType @default(OTHER)
  releaseDate DateTime
  notes       String?
  /// Half-stars, so 1–10 where 7 means three and a half. Null for unrated.
  ///
  /// Stored doubled rather than as a decimal: the scale has exactly ten steps,
  /// and an integer cannot land between two of them the way a float can.
  rating      Int?
  /// Picked out as a favourite. Deliberately not the same as a five-star
  /// rating: a rating is a judgement of the record, a favourite is a shortlist,
  /// and plenty of people have more five-stars than they would shortlist.
  favourite   Boolean     @default(false)
  coverUrl    String?
  createdAt   DateTime    @default(now())

  // Whether you've heard it, kept separate from when. A back catalogue imported
  // with "Heard already" is listened with no date, because the import date says
  // nothing about when it was actually heard.
  listened   Boolean   @default(false)
  listenedAt DateTime?

  /// When it was last un-ticked, so an immediate re-tick can be read as undoing
  /// a mistap rather than as a fresh listen.
  ///
  /// Timing is what separates the two: an accidental un-tick is noticed within
  /// seconds, while genuinely deciding you had not heard something, playing it,
  /// and ticking it off again takes longer than any mistake does. Without this
  /// the app had to guess, and it guessed wrong on an imported back catalogue —
  /// heard but undated, so re-ticking invented today's date and dropped a
  /// decade-old record into "Recently listened".
  unheardAt DateTime?

  /// Set when a release turned up *after* you were already following the
  /// artist, rather than arriving with them.
  ///
  /// The distinction cannot be recovered later: a release created a minute
  /// after the artist and one created a year after look the same on a
  /// timestamp, and an imported artist pointed at a service later muddies it
  /// further. So it is recorded at the moment it is known — by the sync that
  /// found it, which is the only code that can tell.
  arrivedAt DateTime?

  /// The first time this was on screen, which is when its fortnight as a new
  /// release starts counting.
  ///
  /// Not the arrival date: away for three months, everything that landed would
  /// have aged out before it was ever seen, which is exactly backwards — the
  /// point of the flag is to catch you up on what you missed.
  firstSeenAt DateTime?

  /// When this was taken off the artist, or null if it is still theirs.
  ///
  /// For a record that isn't really theirs — a various-artists compilation they
  /// guest on two tracks of, which a service files under their name. Deleting
  /// it does not work: the row is what tells the next sync it already knows
  /// about this release, so a deleted one comes straight back the following
  /// night. Marking it is what makes removal stick.
  ///
  /// Reversible, like every other decision here. Nothing is destroyed — the
  /// tracklist, notes and heard marks are all still on the row if it is put
  /// back.
  removedAt DateTime?

  /// Deliberately not planned for, without claiming to have heard it.
  ///
  /// A third state is needed because the other two both say the wrong thing
  /// about a record you have decided to skip: leaving it unheard keeps it in
  /// the queue forever, and marking it heard is simply untrue. Reversible by
  /// design — a decision not to listen now is not a decision for good.
  setAside   Boolean   @default(false)
  setAsideAt DateTime?

  // Provider id, so re-syncing updates a release instead of duplicating it.
  // Null for releases entered by hand.
  externalId String?

  /// Key from an imported file, kept apart from the provider id so a release
  /// can be matched by either — the same record can come from both.
  importKey String?

  /// What kind of record this is, where something knows better than the title
  /// does. A file that says "OST" or "Concert Film" is stating a fact the four
  /// stored types cannot hold and the title does not reveal.
  category String?

  // Tracklists are fetched per release rather than during an artist sync: one
  // request per album would make importing a large discography very slow.
  tracks         Track[]
  tracksSyncedAt DateTime?

  @@unique([artistId, externalId])
  @@unique([artistId, importKey])
  @@index([artistId])
  @@index([releaseDate])
  @@index([listened])
  @@index([setAside])
}

/// One track as it appears on one release. The same song may have several.
model Track {
  id        String  @id @default(cuid())
  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  /// Length in seconds, when the provider reports one.
  duration  Int?

  /// A favourite song *on this release*, at most three per release.
  ///
  /// On the track rather than the song, unlike listening state: hearing a song
  /// is a fact about the song wherever it turns up, but a favourite is a
  /// statement about one record. A track can be a highlight of the album and
  /// merely present on the greatest-hits.
  favourite Boolean @default(false)

  // Same idea as Release.externalId: re-fetching a tracklist updates rows
  // instead of duplicating them.
  externalId String?
  /// Identifies a recording. Stored for future use; matching is by title today.
  isrc       String?

  // Listening state lives on Song, not here, so hearing a track once counts
  // wherever else that song appears.
  songId String?
  song   Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([releaseId, externalId])
  @@index([releaseId])
  @@index([songId])
}

/// Something to check out that isn't part of the tracker.
///
/// Deliberately separate from Artist and Release: these are people you don't
/// follow and records you may never keep. Mixing them into the library would
/// put things you haven't decided about into a queue that means "new from
/// someone I follow".
model Discovery {
  id String @id @default(cuid())

  artistName String
  /// The song or record to hear. Null means the artist themselves is the lead.
  title      String?
  note       String?

  heard   Boolean   @default(false)
  heardAt DateTime?

  /// Where it came from: "manual", or a playlist source such as "spotify".
  source     String  @default("manual")
  /// The source's own id, so re-reading a playlist updates instead of duplicating.
  externalId String?
  /// A link back to wherever it was found.
  url        String?

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([heard])
}

/// A song, independent of which releases carry it. Marking it heard counts
/// everywhere it appears: the single, the album, the deluxe, the remaster.
model Song {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  /// Identity within the artist, from src/lib/song-identity.ts.
  key   String
  title String

  listened   Boolean   @default(false)
  listenedAt DateTime?

  tracks    Track[]
  createdAt DateTime @default(now())

  @@unique([artistId, key])
  @@index([artistId])
  @@index([listened])
}

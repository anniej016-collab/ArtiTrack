# Connection string for your Postgres database.
# Local development example:
#   DATABASE_URL="postgresql://user:password@127.0.0.1:5432/artitrack?schema=public"
DATABASE_URL=

# Optional. Only needed if your provider gives you a separate non-pooled
# connection string. Migrations use it when present.
# DIRECT_DATABASE_URL=

# You do not need to set these by hand. Vercel's Postgres integration creates
# them for you, and the app falls back to them when DATABASE_URL is absent:
#   POSTGRES_PRISMA_URL, POSTGRES_URL       (pooled — used for queries)
#   DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING  (direct — used for migrations)
# Custom-prefixed names work too: anything holding a postgres:// URL is found.

# Optional. Points the Deezer client somewhere else, which is only useful for
# testing against a stand-in server. Deezer's public API needs no key.
# DEEZER_API_BASE=

# Database used by the end-to-end tests. They truncate every table, so this
# must NOT point at the database holding real data. Falls back to DATABASE_URL.
# TEST_DATABASE_URL=

# Points Playwright at an already-installed Chromium, for sandboxes and CI
# images that ship one and block the download.
# PLAYWRIGHT_CHROMIUM_PATH=

# Set this to put the whole app behind a password. Unset or empty means no gate,
# which is what you want locally and for the tests. Set it in the Vercel
# project's Environment Variables for the deployed app.
# ARTITRACK_PASSWORD=

# Required for the nightly release check. Vercel sends it as a bearer token to
# /api/cron/sync; the route refuses to run when it is unset.
# CRON_SECRET=

# Spotify is searched first, and is the only source needing credentials. These
# are app credentials, not anyone's login: nothing reads a user's account, only
# the public catalogue. Create an app at developer.spotify.com, tick Web API,
# and copy the two values from its Settings.
#
# Leave them unset and nothing breaks — Spotify is skipped and Deezer, which
# needs no key at all, answers instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

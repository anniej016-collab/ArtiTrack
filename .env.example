# Connection string for your Postgres database.
# Local development example:
#   DATABASE_URL="postgresql://user:password@127.0.0.1:5432/artitrack?schema=public"
# On Vercel this is set automatically if you create the database from the
# project's Storage tab.
DATABASE_URL=

# Optional. Only needed if your provider gives you a separate non-pooled
# connection string (Neon / Vercel Postgres do). Migrations use it when present.
# DIRECT_DATABASE_URL=

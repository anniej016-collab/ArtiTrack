# Connection string for your Postgres database.
# Local development example:
#   DATABASE_URL="postgresql://user:password@127.0.0.1:5432/artitrack?schema=public"
DATABASE_URL=

# Optional. Only needed if your provider gives you a separate non-pooled
# connection string. Migrations use it when present.
# DIRECT_DATABASE_URL=

# You do not need to set these by hand. Vercel's Postgres integration creates
# them for you, and the app falls back to them when DATABASE_URL is absent:
#   POSTGRES_PRISMA_URL, POSTGRES_URL       (pooled — used for queries)
#   DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING  (direct — used for migrations)
# Custom-prefixed names work too: anything holding a postgres:// URL is found.

# Optional. Points the Deezer client somewhere else, which is only useful for
# testing against a stand-in server. Deezer's public API needs no key.
# DEEZER_API_BASE=
